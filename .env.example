# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Cloudinary image upload configuration (Admin product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateways (Nigeria NGN & Australia AUD)
KORAPAY_SECRET_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Email / Notification Gateway (Automatic Pay Small Small & Subscription Reminders)
RESEND_API_KEY=
EMAIL_FROM=orders@samsarachoice.com


# Server-side Firestore access for signed KoraPay settlement and scheduled subscription reminders
# Store the complete Firebase service-account JSON as one encrypted Vercel environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=
