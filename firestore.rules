rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPrimaryAdmin() {
      return isSignedIn() && request.auth.token.email == 'samsarachoice1@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 2. Entity Validation Helpers
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() > 3 && data.email.size() <= 200
        && data.role in ['super_admin', 'store_admin']
        && data.createdAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'ngnPerAud', 'ngDeliveryFee', 'auDeliveryFee',
          'pssEnabled', 'pssDefaultDepositPercent', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ngnPerAud', 'ngDeliveryFee', 'auDeliveryFee',
          'ngFreeDeliveryThreshold', 'auFreeDeliveryThreshold',
          'pssEnabled', 'pssDefaultDepositPercent', 'pssMinOrderNGN',
          'pssMinOrderAUD', 'pssReleaseThresholdPercent', 'pssMaxPeriods',
          'pssAllowedFrequencies', 'subscriptionDiscountPercent', 'updatedAt'
        ])
        && data.ngnPerAud is number && data.ngnPerAud > 0
        && data.ngDeliveryFee is number && data.ngDeliveryFee >= 0
        && data.auDeliveryFee is number && data.auDeliveryFee >= 0
        && data.pssEnabled is bool
        && data.pssDefaultDepositPercent is number && data.pssDefaultDepositPercent >= 5 && data.pssDefaultDepositPercent <= 90
        && (!('pssAllowedFrequencies' in data) || (data.pssAllowedFrequencies is list && data.pssAllowedFrequencies.size() > 0 && data.pssAllowedFrequencies.size() <= 5 && data.pssAllowedFrequencies[0] is string))
        && data.updatedAt == request.time;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'subcategories', 'sortOrder'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'image', 'subcategories', 'sortOrder'])
        && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 400))
        && (!('image' in data) || (data.image is string && data.image.size() <= 600))
        && data.subcategories is list && data.subcategories.size() <= 30
        && (data.subcategories.size() == 0 || data.subcategories[0] is string)
        && data.sortOrder is number;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'categoryId', 'priceNGN', 'priceAUD',
          'images', 'stock', 'pssEligible', 'subscriptionEligible'
        ])
        && data.keys().hasOnly([
          'id', 'sku', 'name', 'categoryId', 'subcategory', 'description',
          'priceNGN', 'priceAUD', 'comparePriceNGN', 'comparePriceAUD',
          'images', 'unit', 'variants', 'stock', 'pssEligible',
          'pssMinDepositPercent', 'subscriptionEligible', 'isBundle',
          'bundleItems', 'featured', 'bestSeller', 'markets',
          'ratingAvg', 'reviewCount', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 180
        && isValidId(data.categoryId)
        && (!('sku' in data) || (data.sku is string && data.sku.size() <= 64))
        && (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 120))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && data.priceNGN is number && data.priceNGN >= 0
        && data.priceAUD is number && data.priceAUD >= 0
        && data.images is list && data.images.size() > 0 && data.images.size() <= 10 && data.images[0] is string
        && (!('variants' in data) || (data.variants is list && data.variants.size() <= 20))
        && (!('bundleItems' in data) || (data.bundleItems is list && data.bundleItems.size() <= 40))
        && (!('markets' in data) || (data.markets is list && data.markets.size() <= 5 && data.markets[0] is string))
        && data.stock is number && data.stock >= 0
        && data.pssEligible is bool
        && data.subscriptionEligible is bool;
    }

    function isValidReview(data, productId) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && isValidId(data.id)
        && data.productId == productId
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1000
        && data.createdAt == request.time;
    }

    function isValidSubscriptionPackage(data) {
      return data.keys().hasAll(['id', 'name', 'priceNGN', 'priceAUD', 'items', 'active'])
        && data.keys().hasOnly(['id', 'name', 'description', 'image', 'frequencyOptions', 'priceNGN', 'priceAUD', 'items', 'active'])
        && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 140
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('image' in data) || (data.image is string && data.image.size() <= 600))
        && data.priceNGN is number && data.priceNGN >= 0
        && data.priceAUD is number && data.priceAUD >= 0
        && data.items is list && data.items.size() > 0 && data.items.size() <= 30 && data.items[0] is string
        && data.active is bool;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'discountType', 'discountValue', 'active'])
        && data.keys().hasOnly(['code', 'discountType', 'discountValue', 'minSpendNGN', 'minSpendAUD', 'active', 'expiresAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 40 && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.discountType in ['percent', 'fixed']
        && data.discountValue is number && data.discountValue > 0
        && data.active is bool;
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'preferredMarket', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'preferredMarket', 'addresses', 'wishlist', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.preferredMarket in ['NG', 'AU']
        && (!('addresses' in data) || (data.addresses is list && data.addresses.size() <= 10))
        && (!('wishlist' in data) || (data.wishlist is list && data.wishlist.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidCartItem(data) {
      return data.keys().hasAll(['id', 'productId', 'name', 'quantity', 'priceNGN', 'priceAUD', 'pssEligible', 'updatedAt'])
        && data.keys().hasOnly(['id', 'productId', 'name', 'image', 'variant', 'quantity', 'priceNGN', 'priceAUD', 'pssEligible', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 180
        && (!('image' in data) || (data.image is string && data.image.size() <= 600))
        && (!('variant' in data) || (data.variant is string && data.variant.size() <= 80))
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 999
        && data.priceNGN is number && data.priceNGN >= 0
        && data.priceAUD is number && data.priceAUD >= 0
        && data.pssEligible is bool
        && data.updatedAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'userId', 'market', 'currency', 'paymentMode',
          'items', 'totalAmount', 'amountPaid', 'balanceRemaining', 'status',
          'fulfilmentStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderNumber', 'userId', 'customerEmail', 'customerName',
          'market', 'currency', 'paymentMode', 'paymentMethod', 'items',
          'subtotal', 'discount', 'deliveryFee', 'totalAmount', 'amountPaid',
          'balanceRemaining', 'couponCode', 'shippingAddress', 'status',
          'fulfilmentStatus', 'trackingCode', 'paymentPlanId', 'subscriptionId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 40
        && isValidId(data.userId)
        && data.market in ['NG', 'AU']
        && data.currency in ['NGN', 'AUD']
        && data.paymentMode in ['buy_now', 'pay_small_small', 'subscription']
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalAmount is number && data.totalAmount >= 0
        && data.amountPaid is number && data.amountPaid >= 0
        && data.balanceRemaining is number && data.balanceRemaining >= 0
        && (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40))
        && (!('trackingCode' in data) || (data.trackingCode is string && data.trackingCode.size() <= 80))
        && data.status in ['pending_verification', 'deposit_paid', 'paid', 'processing', 'in_transit', 'delivered', 'cancelled']
        && data.fulfilmentStatus in ['locked_until_paid', 'eligible_for_dispatch', 'dispatched', 'delivered']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPaymentPlan(data) {
      return data.keys().hasAll([
          'id', 'userId', 'orderId', 'market', 'currency', 'totalAmount',
          'depositAmount', 'amountPaid', 'balanceRemaining', 'frequency',
          'totalInstalments', 'paidInstalments', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerEmail', 'customerName', 'orderId', 'orderNumber',
          'market', 'currency', 'totalAmount', 'depositPercent', 'depositAmount',
          'amountPaid', 'balanceRemaining', 'frequency', 'totalInstalments',
          'paidInstalments', 'instalmentAmount', 'nextPaymentDate',
          'releaseThresholdPercent', 'status', 'schedule', 'remindersSent',
          'lastReminderAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.orderId)
        && data.market in ['NG', 'AU']
        && data.currency in ['NGN', 'AUD']
        && data.totalAmount is number && data.totalAmount > 0
        && data.depositAmount is number && data.depositAmount >= 0
        && data.amountPaid is number && data.amountPaid >= 0
        && data.balanceRemaining is number && data.balanceRemaining >= 0
        && data.frequency in ['weekly', 'biweekly', 'monthly']
        && data.totalInstalments is number && data.totalInstalments >= 1 && data.totalInstalments <= 24
        && data.paidInstalments is number && data.paidInstalments >= 0 && data.paidInstalments <= 24
        && data.status in ['pending_deposit', 'active', 'overdue', 'completed', 'cancelled']
        && (!('schedule' in data) || (data.schedule is list && data.schedule.size() <= 24))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll([
          'id', 'userId', 'planName', 'frequency', 'market', 'currency',
          'items', 'pricePerCycle', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerEmail', 'customerName', 'packageId', 'planName',
          'isCustom', 'frequency', 'market', 'currency', 'items', 'pricePerCycle',
          'autoRenew', 'status', 'nextDeliveryDate', 'nextRenewalDate',
          'renewalCount', 'shippingAddress', 'remindersSent', 'lastReminderAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.planName is string && data.planName.size() > 0 && data.planName.size() <= 140
        && data.frequency in ['weekly', 'biweekly', 'monthly']
        && data.market in ['NG', 'AU']
        && data.currency in ['NGN', 'AUD']
        && data.items is list && data.items.size() > 0 && data.items.size() <= 30
        && data.pricePerCycle is number && data.pricePerCycle >= 0
        && data.status in ['pending_payment', 'active', 'paused', 'renewal_due', 'cancelled']
        && (!('lastReminderAt' in data) || (data.lastReminderAt is string && data.lastReminderAt.size() <= 40))
        && (!('remindersSent' in data) || (data.remindersSent is number && data.remindersSent >= 0))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'id', 'userId', 'orderId', 'type', 'market', 'currency',
          'amount', 'gateway', 'reference', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerEmail', 'orderId', 'paymentPlanId', 'subscriptionId',
          'type', 'market', 'currency', 'amount', 'gateway', 'reference',
          'status', 'verifiedBy', 'receiptUrl', 'receiptPublicId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.orderId)
        && data.type in ['buy_now', 'pss_deposit', 'pss_instalment', 'subscription_cycle']
        && data.market in ['NG', 'AU']
        && data.currency in ['NGN', 'AUD']
        && data.amount is number && data.amount > 0
        && data.gateway in ['korapay', 'paystack', 'stripe', 'flutterwave', 'bank_transfer', 'payid']
        && data.reference is string && data.reference.size() >= 4 && data.reference.size() <= 160
        && data.status in ['pending_verification', 'verified', 'failed']
        && (!('receiptUrl' in data) || (data.receiptUrl is string && data.receiptUrl.size() <= 1000))
        && (!('receiptPublicId' in data) || (data.receiptPublicId is string && data.receiptPublicId.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'targetRole', 'userId', 'type', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['id', 'targetRole', 'userId', 'type', 'title', 'message', 'relatedId', 'read', 'createdAt'])
        && isValidId(data.id)
        && data.targetRole in ['admin', 'customer']
        && isValidId(data.userId)
        && data.type in ['new_order', 'payment_verification', 'pss_reminder', 'pss_overdue', 'subscription_renewal']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.message is string && data.message.size() > 0 && data.message.size() <= 600
        && data.read is bool
        && data.createdAt is timestamp;
    }

    // 3. Collection Rules

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(uid) && isPrimaryAdmin() && isValidAdminUser(incoming());
      allow delete: if isValidId(uid) && isPrimaryAdmin();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidStoreSettings(incoming());
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();

      match /reviews/{reviewId} {
        allow get: if isValidId(productId) && isValidId(reviewId);
        allow list: if isValidId(productId);
        allow create: if isValidId(productId) && isValidId(reviewId)
          && isEmailVerified()
          && exists(/databases/$(database)/documents/products/$(productId))
          && isValidReview(incoming(), productId);
        allow update: if false;
        allow delete: if isValidId(productId) && isValidId(reviewId)
          && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      }
    }

    match /subscriptionPlans/{planId} {
      allow get: if isValidId(planId);
      allow list: if true;
      allow create, update: if isValidId(planId) && isAdmin() && isValidSubscriptionPackage(incoming());
      allow delete: if isValidId(planId) && isAdmin();
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if isAdmin();
      allow create, update: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming());
      allow delete: if isValidId(couponId) && isAdmin();
    }

    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(uid) && isSignedIn() && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time;
      allow update: if isValidId(uid) && isSignedIn() && (isOwner(uid) || isAdmin())
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'preferredMarket', 'addresses', 'wishlist', 'updatedAt']);
      allow delete: if isValidId(uid) && isAdmin();

      match /cart/{cartItemId} {
        allow get: if isValidId(uid) && isValidId(cartItemId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
        allow create, update: if isValidId(uid) && isValidId(cartItemId) && isOwner(uid) && isValidCartItem(incoming());
        allow delete: if isValidId(uid) && isValidId(cartItemId) && isOwner(uid);
      }
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isEmailVerified()
        && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().status in ['pending_verification', 'deposit_paid', 'paid']
        && (incoming().paymentMode != 'pay_small_small' || incoming().fulfilmentStatus == 'locked_until_paid');
      allow update: if isValidId(orderId) && isEmailVerified() && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && existing().status != 'cancelled'
            && existing().status != 'delivered'
            && (
              (incoming().status == 'cancelled'
                && existing().amountPaid == 0
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
              || (incoming().amountPaid >= existing().amountPaid
                && incoming().balanceRemaining <= existing().balanceRemaining
                && incoming().totalAmount == existing().totalAmount
                && (
                  incoming().fulfilmentStatus == existing().fulfilmentStatus
                  || (incoming().balanceRemaining == 0 && incoming().amountPaid >= existing().totalAmount && incoming().fulfilmentStatus == 'eligible_for_dispatch')
                )
                && incoming().diff(existing()).affectedKeys().hasOnly(['amountPaid', 'balanceRemaining', 'status', 'fulfilmentStatus', 'updatedAt']))
            )
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /paymentPlans/{planId} {
      allow get: if isValidId(planId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(planId) && isEmailVerified()
        && isValidPaymentPlan(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(planId) && isEmailVerified() && isValidPaymentPlan(incoming())
        && incoming().userId == existing().userId
        && incoming().orderId == existing().orderId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && existing().status != 'cancelled'
            && existing().status != 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['amountPaid', 'balanceRemaining', 'paidInstalments', 'nextPaymentDate', 'status', 'schedule', 'updatedAt'])
          )
        );
      allow delete: if isValidId(planId) && isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow get: if isValidId(subscriptionId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(subscriptionId) && isEmailVerified()
        && isValidSubscription(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(subscriptionId) && isEmailVerified() && isValidSubscription(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && existing().status in ['active', 'paused', 'renewal_due']
            && incoming().status in ['active', 'paused', 'renewal_due', 'cancelled']
            && incoming().diff(existing()).affectedKeys().hasOnly(['frequency', 'items', 'pricePerCycle', 'autoRenew', 'status', 'nextDeliveryDate', 'nextRenewalDate', 'renewalCount', 'shippingAddress', 'updatedAt'])
          )
        );
      allow delete: if isValidId(subscriptionId) && isAdmin();
    }

    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(transactionId) && isEmailVerified()
        && isValidTransaction(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || incoming().status == 'pending_verification'
          || (incoming().gateway in ['paystack', 'stripe', 'flutterwave'] && incoming().status in ['pending_verification', 'verified'])
        );
      allow update: if isValidId(transactionId) && isAdmin() && isValidTransaction(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(transactionId) && isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(notificationId) && isEmailVerified()
        && isValidNotification(incoming())
        && incoming().createdAt == request.time
        && (isAdmin() || incoming().userId == request.auth.uid);
      allow update: if isValidId(notificationId) && isEmailVerified()
        && isValidNotification(incoming())
        && (isAdmin() || (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])));
      allow delete: if isValidId(notificationId) && isAdmin();
    }
  }
}
