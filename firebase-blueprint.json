{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorised administrator registry document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "store_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global market, currency exchange rate, delivery fees, and Pay Small Small configuration.",
      "type": "object",
      "properties": {
        "ngnPerAud": { "type": "number" },
        "ngDeliveryFee": { "type": "number" },
        "auDeliveryFee": { "type": "number" },
        "ngFreeDeliveryThreshold": { "type": "number" },
        "auFreeDeliveryThreshold": { "type": "number" },
        "pssEnabled": { "type": "boolean" },
        "pssDefaultDepositPercent": { "type": "number" },
        "pssMinOrderNGN": { "type": "number" },
        "pssMinOrderAUD": { "type": "number" },
        "pssReleaseThresholdPercent": { "type": "number" },
        "pssMaxPeriods": { "type": "number" },
        "pssAllowedFrequencies": { "type": "array" },
        "subscriptionDiscountPercent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ngnPerAud", "ngDeliveryFee", "auDeliveryFee", "pssEnabled", "pssDefaultDepositPercent", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Storefront product category and subcategories.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 400 },
        "image": { "type": "string", "maxLength": 600 },
        "subcategories": { "type": "array" },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "name", "slug", "subcategories", "sortOrder"]
    },
    "Product": {
      "title": "Product",
      "description": "Storefront product with Nigeria (NGN) and Australia (AUD) market pricing and Pay Small Small eligibility.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sku": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 180 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "subcategory": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "priceNGN": { "type": "number" },
        "priceAUD": { "type": "number" },
        "comparePriceNGN": { "type": "number" },
        "comparePriceAUD": { "type": "number" },
        "images": { "type": "array" },
        "unit": { "type": "string", "maxLength": 60 },
        "variants": { "type": "array" },
        "stock": { "type": "number" },
        "pssEligible": { "type": "boolean" },
        "pssMinDepositPercent": { "type": "number" },
        "subscriptionEligible": { "type": "boolean" },
        "isBundle": { "type": "boolean" },
        "bundleItems": { "type": "array" },
        "featured": { "type": "boolean" },
        "bestSeller": { "type": "boolean" },
        "markets": { "type": "array" },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "categoryId", "priceNGN", "priceAUD", "images", "stock", "pssEligible", "subscriptionEligible"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Customer review for a specific product.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "SubscriptionPackage": {
      "title": "SubscriptionPackage",
      "description": "Preconfigured foodstuff subscription package template.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 600 },
        "frequencyOptions": { "type": "array" },
        "priceNGN": { "type": "number" },
        "priceAUD": { "type": "number" },
        "items": { "type": "array" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "priceNGN", "priceAUD", "items", "active"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 40, "pattern": "^[A-Z0-9_\\-]+$" },
        "discountType": { "type": "string", "enum": ["percent", "fixed"] },
        "discountValue": { "type": "number" },
        "minSpendNGN": { "type": "number" },
        "minSpendAUD": { "type": "number" },
        "active": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private customer profile, saved addresses, and wishlist.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "preferredMarket": { "type": "string", "enum": ["NG", "AU"] },
        "addresses": { "type": "array" },
        "wishlist": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "preferredMarket", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Item in a user's persistent cart.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 180 },
        "image": { "type": "string", "maxLength": 600 },
        "variant": { "type": "string", "maxLength": 80 },
        "quantity": { "type": "number" },
        "priceNGN": { "type": "number" },
        "priceAUD": { "type": "number" },
        "pssEligible": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "name", "quantity", "priceNGN", "priceAUD", "pssEligible", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with market, currency, payment mode, fulfilment policy, and tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 120 },
        "market": { "type": "string", "enum": ["NG", "AU"] },
        "currency": { "type": "string", "enum": ["NGN", "AUD"] },
        "paymentMode": { "type": "string", "enum": ["buy_now", "pay_small_small", "subscription"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balanceRemaining": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 40 },
        "shippingAddress": { "type": "object" },
        "status": { "type": "string", "enum": ["pending_verification", "deposit_paid", "paid", "processing", "in_transit", "delivered", "cancelled"] },
        "fulfilmentStatus": { "type": "string", "enum": ["locked_until_paid", "eligible_for_dispatch", "dispatched", "delivered"] },
        "trackingCode": { "type": "string", "maxLength": 80 },
        "paymentPlanId": { "type": "string", "maxLength": 128 },
        "subscriptionId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "userId", "market", "currency", "paymentMode", "items", "totalAmount", "amountPaid", "balanceRemaining", "status", "fulfilmentStatus", "createdAt", "updatedAt"]
    },
    "PaymentPlan": {
      "title": "PaymentPlan",
      "description": "Pay Small Small instalment plan linked to an order.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 120 },
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "market": { "type": "string", "enum": ["NG", "AU"] },
        "currency": { "type": "string", "enum": ["NGN", "AUD"] },
        "totalAmount": { "type": "number" },
        "depositPercent": { "type": "number" },
        "depositAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balanceRemaining": { "type": "number" },
        "frequency": { "type": "string", "enum": ["weekly", "biweekly", "monthly"] },
        "totalInstalments": { "type": "number" },
        "paidInstalments": { "type": "number" },
        "instalmentAmount": { "type": "number" },
        "nextPaymentDate": { "type": "string", "format": "date-time" },
        "releaseThresholdPercent": { "type": "number" },
        "status": { "type": "string", "enum": ["pending_deposit", "active", "overdue", "completed", "cancelled"] },
        "schedule": { "type": "array" },
        "remindersSent": { "type": "number" },
        "lastReminderAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "orderId", "market", "currency", "totalAmount", "depositAmount", "amountPaid", "balanceRemaining", "frequency", "totalInstalments", "paidInstalments", "status", "createdAt", "updatedAt"]
    },
    "CustomerSubscription": {
      "title": "CustomerSubscription",
      "description": "Recurring weekly or monthly foodstuff subscription owned by a customer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 120 },
        "packageId": { "type": "string", "maxLength": 128 },
        "planName": { "type": "string", "maxLength": 140 },
        "isCustom": { "type": "boolean" },
        "frequency": { "type": "string", "enum": ["weekly", "biweekly", "monthly"] },
        "market": { "type": "string", "enum": ["NG", "AU"] },
        "currency": { "type": "string", "enum": ["NGN", "AUD"] },
        "items": { "type": "array" },
        "pricePerCycle": { "type": "number" },
        "autoRenew": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "paused", "renewal_due", "cancelled"] },
        "nextDeliveryDate": { "type": "string", "format": "date-time" },
        "nextRenewalDate": { "type": "string", "format": "date-time" },
        "renewalCount": { "type": "number" },
        "shippingAddress": { "type": "object" },
        "remindersSent": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "planName", "frequency", "market", "currency", "items", "pricePerCycle", "status", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Payment transaction record with gateway verification status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "orderId": { "type": "string", "maxLength": 128 },
        "paymentPlanId": { "type": "string", "maxLength": 128 },
        "subscriptionId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["buy_now", "pss_deposit", "pss_instalment", "subscription_cycle"] },
        "market": { "type": "string", "enum": ["NG", "AU"] },
        "currency": { "type": "string", "enum": ["NGN", "AUD"] },
        "amount": { "type": "number" },
        "gateway": { "type": "string", "enum": ["paystack", "stripe", "flutterwave", "bank_transfer", "payid"] },
        "reference": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["pending_verification", "verified", "failed"] },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "orderId", "type", "market", "currency", "amount", "gateway", "reference", "status", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System and reminder notifications for admins and customers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetRole": { "type": "string", "enum": ["admin", "customer"] },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["new_order", "payment_verification", "pss_reminder", "pss_overdue", "subscription_renewal"] },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 600 },
        "relatedId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetRole", "userId", "type", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin user role documents."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Storewide currency, delivery, and Pay Small Small configuration."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories and subcategories."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog documents."
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Customer reviews for products."
    },
    "/subscriptionPlans/{planId}": {
      "schema": { "$ref": "#/entities/SubscriptionPackage" },
      "description": "Preconfigured foodstuff subscription package templates."
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount codes keyed by coupon code."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profiles, addresses, and wishlists."
    },
    "/users/{uid}/cart/{cartItemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Account-isolated shopping cart items."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders."
    },
    "/paymentPlans/{planId}": {
      "schema": { "$ref": "#/entities/PaymentPlan" },
      "description": "Pay Small Small instalment plans."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/CustomerSubscription" },
      "description": "Customer recurring foodstuff subscriptions."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Payment verification and receipt transactions."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Automated payment, renewal, and order notifications."
    }
  }
}
